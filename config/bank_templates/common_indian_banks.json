{
  "schema_version": 2,
  "defaults": {
    "mapping": {
      "transaction_date": null,
      "value_date": null,
      "description": null,
      "reference_number": null,
      "cheque_number": null,
      "debit": null,
      "credit": null,
      "amount": null,
      "dr_cr": null,
      "balance": null,
      "header_row": 0,
      "date_format": "AUTO"
    },
    "ignore_phrases": [
      "Opening Balance",
      "Closing Balance",
      "Brought Forward",
      "Carried Forward",
      "Page Total",
      "Statement Summary"
    ],
    "cleanup_rules": [
      {"pattern": "\\s+", "replacement": " "}
    ],
    "multiline_narration": {"enabled": true, "joiner": " "}
  },
  "templates": [
    {
      "template_id": "state_bank_of_india",
      "bank_name": "State Bank of India",
      "detection_keywords": ["State Bank of India", "SBI", "sbi.co.in"],
      "column_aliases": {
        "transaction_date": ["Txn Date"],
        "value_date": ["Value Date"],
        "description": ["Description"],
        "reference_number": ["Ref No./Cheque No."],
        "debit": ["Debit"],
        "credit": ["Credit"],
        "balance": ["Balance"]
      }
    },
    {
      "template_id": "south_indian_bank",
      "bank_name": "South Indian Bank",
      "detection_keywords": ["South Indian Bank", "southindianbank.com"],
      "column_aliases": {"description": ["Particulars"], "reference_number": ["Chq/Ref No"], "debit": ["Withdrawal"], "credit": ["Deposit"]}
    },
    {
      "template_id": "federal_bank",
