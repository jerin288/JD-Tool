    {
      "template_id": "canara_bank",
      "bank_name": "Canara Bank",
      "detection_keywords": ["Canara Bank", "canarabank.com"],
      "column_aliases": {"transaction_date": ["Transaction Date"], "description": ["Description"], "reference_number": ["Cheque No"], "debit": ["Debit Amount"], "credit": ["Credit Amount"]}
    },
    {
      "template_id": "punjab_national_bank",
